# env umum untuk seluruh test; env dari shell tetap menang. Key API test ada di testutil/keys.go

# database dev
PG_DRIVER=postgres
PG_HOST=localhost
PG_PORT=6434
PG_USER=postgres
PG_PASSWORD=postgres
PG_NAME=ildki
PG_SCHEMA=stunting
PG_SSLMODE=disable
# PG_DSN=postgres://postgres:postgres@localhost:6434/ildki?sslmode=disable

# redis (integration/ratelimit_redis); password bawaan dari config.yaml
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# faskes fixture
ORGID_FASKES=100011

# service yang sudah berjalan; isi saat menjalankan paketnya saja, kosong = aplikasi in-process
# API_BASE=http://127.0.0.1:2025/api
# API_HEALTH=http://127.0.0.1:2025/stunting/health

# keluaran
# UJI_LOG=stdout
