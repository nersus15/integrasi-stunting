# Spesifikasi server yang disimulasikan. Postgres, Redis, dan app berjalan dalam
# satu container ("box") sehingga berbagi CPU, RAM, dan disk seperti satu mesin.
# Ubah nilai di sini lalu jalankan ulang: ./jalankan.sh uji <mode>

# --- mesin ---
SERVER_CPUS=2
SERVER_MEMORY=4g

# --- disk (asumsi HDD 7200rpm) ---
# batas IOPS dan throughput untuk seluruh IO box ke disk host
DISK_DEVICE=/dev/nvme0n1
DISK_READ_IOPS=150
DISK_WRITE_IOPS=150
DISK_READ_MBPS=120
DISK_WRITE_MBPS=100
# latensi tiap flush WAL (fsync) dalam milidetik; 0 = SSD
DISK_FSYNC_MS=8

# --- postgres ---
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=100
PG_RANDOM_PAGE_COST=4
PG_EFFECTIVE_IO_CONCURRENCY=2
PG_SYNCHRONOUS_COMMIT=on
PG_MAX_WAL_SIZE=1GB
# ekstensi tambahan, mis. pg_stat_statements untuk diagnosis; kosong = seperti server
PG_PRELOAD=

# --- app ---
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
APP_LOG_LEVEL=info
# rate limit per API key; false supaya yang diukur kapasitas server, bukan limiter
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=1000

# --- volume data awal ---
SEED_ANAK=300000
SEED_KUNJUNGAN_PER_ANAK=5
SEED_PUSKESMAS=40
SEED_RS=10
# persen anak yang punya rujukan aktif ke RS (akses klinis)
SEED_PERSEN_RUJUKAN=10
