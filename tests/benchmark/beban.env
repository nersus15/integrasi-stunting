# Profil beban. Laju naik bertahap sampai salah satu batas jenuh terlampaui.

# --- HTTP ---
# laju awal (request/detik), dikalikan FAKTOR tiap tahap sampai LAJU_MAKS
HTTP_LAJU_AWAL=10
HTTP_FAKTOR=1.5
HTTP_LAJU_MAKS=2000
DURASI_TAHAP=60s
# request yang masih berjalan melebihi ini dianggap antre di klien (tanda jenuh)
MAKS_INFLIGHT=1000
HTTP_TIMEOUT=30s

# bobot campuran operasi HTTP (relatif, 0 = tidak dipakai)
BOBOT_GET_ANAK=20
BOBOT_GET_KUNJUNGAN_ANAK=10
BOBOT_GET_SUMMARY=10
BOBOT_GET_ORANGTUA=5
BOBOT_GET_FASKES=15
BOBOT_GET_FASKES_ORANGTUA=5
BOBOT_REGISTRASI=10
BOBOT_KUNJUNGAN=15
BOBOT_KESEHATAN=3
BOBOT_PUT_ANAK=2
BOBOT_PUT_ORANGTUA=2
BOBOT_FASKES_PEMERIKSAAN=6
BOBOT_FASKES_PUT_KUNJUNGAN=2

# --- Kafka ---
# laju dalam pesan/detik; satu perjalanan anak = 6 pesan berurutan
KAFKA_LAJU_AWAL=2
KAFKA_FAKTOR=1.5
KAFKA_LAJU_MAKS=500
KAFKA_PARTISI=6
# perjalanan anak minimal yang diantrekan sekaligus untuk mengukur kapasitas consumer
# (otomatis diperbesar supaya antrean bertahan ~60 detik)
KAFKA_BURST_ANAK=200

# --- campuran (HTTP + Kafka bersamaan) ---
# persen dari titik jenuh masing-masing jalur yang ditemukan di mode http/kafka
CAMPURAN_PERSEN=70
DURASI_CAMPURAN=5m

# --- batas jenuh ---
BATAS_P95_MS=1000
BATAS_ERROR_PERSEN=1
