app:
  name: integrasi-stunting
  version: 1.0.0
  environment: development

  # features flags
  features:
    recovery: true
    metrics: false
    tracing: false
    profiling: false

  # logging settings
  logging:
    level: debug
    format: "${time} | ${status} | ${latency} | ${ip} | ${method} | ${path} | ${error}\n"
    output: stdout
    # remote:
    #   driver: "sentry"
    #   uri: ""
    #   sample_rate: 1.0
    #   structured: true
    #   default_tags:
    #     service: "mini-proxy-test"
    #   default_context: {}

  # Security settings
  security_headers: true

  # CORS settings
  cors:
    allow_origins:
      - "http://localhost:2025"
      - "http://localhost:8080"
    allow_methods:
      - "GET"
      - "POST"
      - "PUT"
      - "DELETE"
      - "OPTIONS"
    allow_headers:
      - "X-API-Key"
      - "Origin"
      - "Content-Type"
      - "Accept"
      - "Authorization"
    allow_credentials: true
    expose_headers:
      - "Content-Length"
    max_age: 24h  # 24 hours

  # API rate limiting settings per minute
  rate_limit:
    enabled: true
    limit: 1000
    # burst: 100

  module:
    base_path: "./ext"
    disabled:
      - "modulea"

server:
  host: 0.0.0.0
  port: 2025
  path: "/api"
  read_timeout: 30s
  write_timeout: 30s

auth:
  type: apikey
  control: RBAC
  store: db # yaml, db
  # type: jwt # Options: "jwt", "apikey", "basic"
  secret_key: "KRxaIzGgRT10YZy8m9GIn2vfJqE3Puo7"
  expires_in: 6h
  refresh_in: 24h
  content_type: application/json
  # username_key: username
  # password_key: password
  # API Key specific settings (only used when type is "apikey")
  # api_key_header: "X-API-Key"  # Header name for API key
  # api_key_prefix: ""  # Optional prefix for API key validation

database:
  driver: postgres
  host: "localhost"
  port: 6434
  user: postgres
  password: postgres
  name: ildki
  schema_name: jakantro
  ssl_mode: disable
  max_idle_conns: 5
  max_open_conns: 10
  conn_max_lifetime: 60m

cron:
  enabled: false
  backup_chunksize: 1000
  schedule: "*/10 23 * * *"

